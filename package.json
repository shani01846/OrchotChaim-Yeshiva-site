{
  "name": "orchot-chaim-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); const path=require('path'); ['.next','node_modules/.cache'].forEach((rel) => fs.rmSync(path.join(process.cwd(), rel), { recursive: true, force: true }));\"",
    "dev": "npm run clean && next dev",
    "build": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@sanity/client": "^7.0.0",
    "@sanity/image-url": "^1.0.0",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "next": "14.2.15",
    "next-intl": "^3.18.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
